# Copy to .env.local. With nothing set, the app runs: DEV wallet + MOCK model (both labelled in the UI).

# --- AI: 0G Private Computer (server-side only, never NEXT_PUBLIC_) ---
# pc.0g.ai -> Dashboard -> API Keys -> Create (set trust mode = Private). Uses the team's 0G credits.
ZG_API_KEY=
# Optional overrides
# ZG_BASE_URL=https://router-api.0g.ai/v1
# ZG_MODEL=0gm-1.0-35b-a3b
# ZG_TRUST_MODE=private   # private = TeeML (sealed) providers only; verified | standard widen the pool

# --- AI fallback: any OpenAI-compatible endpoint, used only if a 0G call fails ---
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=gpt-4.1-mini

# --- Login: Privy embedded wallet (email/Google, no seed phrase) ---
# For the iAI bonus, use the Privy app ID that 0G shares at the event (works on localhost:3000/3001/5173 only).
NEXT_PUBLIC_PRIVY_APP_ID=
