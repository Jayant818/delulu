# Copy to .env.local. With nothing set, the app runs: DEV wallet + MOCK model (both labelled in the UI).

# VERCEL (the website only; the Telegram bot is a separate long-running process and does not run on Vercel):
#   required  ZG_API_KEY                      without it every answer is MOCK
#   optional  NEXT_PUBLIC_DEMO_FAST=1         check-back after 1 min (demo); NEXT_PUBLIC_* are baked in at build: redeploy
#   optional  TRYON_SALT                      random string; salts the try-on usage counters (else a fixed default)
#   optional  TRYON_CAP_TOTAL / TRYON_CAP_USER  default 40 / 5 a day; on Vercel they hold per function instance (/tmp)
#   optional  NEXT_PUBLIC_PRIVY_APP_ID        email/Google login; add the Vercel domain to the app's allowed origins.
#                                             Unset: a device key is made automatically (no login screen)
#   optional  NEXT_PUBLIC_TELEGRAM_BOT        shows the Telegram link on the landing page (bot must run elsewhere)
#   not used on Vercel: TELEGRAM_BOT_TOKEN, BOT_MASTER_KEY, BOT_*, DEMO_FAST, OPENAI_*

# --- AI: 0G Private Computer (server-side only, never NEXT_PUBLIC_) ---
# pc.0g.ai -> Dashboard -> API Keys -> Create (set trust mode = Private). Uses the team's 0G credits.
ZG_API_KEY=
# Optional overrides
# ZG_BASE_URL=https://router-api.0g.ai/v1
# ZG_MODEL=0gm-1.0-35b-a3b
# ZG_TRUST_MODE=private   # private = TeeML (sealed) providers only; verified | standard widen the pool

# --- AI fallback: any OpenAI-compatible endpoint, used only if a 0G call fails ---
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=gpt-4.1-mini

# --- Login: Privy embedded wallet (email/Google, no seed phrase) ---
# For the iAI bonus, use the Privy app ID that 0G shares at the event (works on localhost:3000/3001/5173 only).
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Telegram bot (main interface): npm run bot ---
# Create the bot at @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# 32 random bytes, base64. Wraps each user's data key; losing it = losing all bot memory.
# node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
BOT_MASTER_KEY=
# Optional
# BOT_DATA_DIR=data/bot      # encrypted records, git-ignored
# BOT_DAILY_LIMIT=150        # model calls per person per day (protects the team's 0G credits)
# DEMO_FAST=1                # 30-day check-back date becomes 1 minute, for the demo video

# --- Landing page ---
# Bot username without @ (from @BotFather). The "Open in Telegram" button links to t.me/<it>; unset = "coming soon".
NEXT_PUBLIC_TELEGRAM_BOT=

# --- Try-on (hair + nails): runs on 0G by default (ZG_API_KEY above), standard tier, ~$0.027/image, capped below ---
# ZG_IMAGE_MODEL=bytedance/seedream-5.0-flash     # or tencent/hy-image-3.5-preview (slower)
# TRYON_BACKEND=openai                            # only to use OpenAI instead (needs OPENAI_API_KEY)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=medium      # low = faster/cheaper
# TRYON_CAP_TOTAL=40               # images per day, all users together
# TRYON_CAP_USER=5                 # images per day, per person (wallet and IP)

# --- Web app demo timing ---
# NEXT_PUBLIC_DEMO_FAST=1          # check-back due 1 min after a pick; first daily check-in 1 min after asking
# NEXT_PUBLIC_CHECKBACK_MS=8000    # exact check-back delay (used by the E2E test)

# Arkiv encrypted memory backup (optional). No relayer key = the Arkiv UI is hidden and the app runs as before.
ARKIV_RELAYER_PRIVATE_KEY=
# Free key from hub.arkiv.network/access-keys. Empty = rate-limited public RPC.
ARKIV_ACCESS_KEY=
